# Application Settings
APP_NAME="Project Sentinel API"
APP_VERSION="0.1.0"

# Database Configuration (PostgreSQL 16)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:your_password_here@localhost:5432/sentinel_db"

# JWT Authentication Configuration
# Generate a secure secret key (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="your-secure-jwt-secret-key-change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
